# Vorlage – kopieren nach .env.local (lokal) bzw. in Vercel unter Settings → Environment Variables eintragen.
# Beide Werte findest du in Supabase unter Project Settings → API. Der Publishable Key ist für den Browser gedacht.
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Registrierung in der App erlauben (nur kurzzeitig auf true setzen, z. B. für einen weiteren eigenen Zugang)
ALLOW_SIGNUP=false
