# Vorlage – kopieren nach .env.local (lokal) bzw. in Vercel unter Settings → Environment Variables eintragen.
# Beide Werte findest du in Supabase unter Project Settings → API. Der Publishable Key ist für den Browser gedacht.
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Registrierung in der App erlauben (nur kurzzeitig auf true setzen, z. B. für einen weiteren eigenen Zugang)
ALLOW_SIGNUP=false

# --- Phase 11: Telegram-Benachrichtigungen (nur auf dem Server, niemals NEXT_PUBLIC_) ---
# Token vom @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456789:ABC...
# Supabase → Project Settings → API Keys → Secret key (umgeht Row Level Security!)
SUPABASE_SECRET_KEY=sb_secret_...
# Zufälliger langer Wert (mind. 16 Zeichen); derselbe Wert steht im Supabase Vault (supabase/cron-notify.sql)
CRON_SECRET=

# --- Phase 12: KI-Funktionen (nur auf dem Server) ---
# Claude Console → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Nur nötig, wenn der Schlüssel keinem Workspace zugeordnet ist (Console → Workspaces → ID kopieren)
ANTHROPIC_WORKSPACE_ID=
